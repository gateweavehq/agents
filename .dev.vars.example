# Copied to .dev.vars by `pnpm dev:setup`, which also fills in a random secret.
# The "Deploy to Cloudflare" button asks for every key set here, so the optional ones stay
# commented out. Uncomment one to use it.

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: enables "Sign in with GitHub". Callback URL: http://localhost:4720/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: connects workspaces to GitHub, to find the agents configured in their repositories.
# Create a GitHub App as docs/github-app.md describes, then fill in all six.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# The .pem file's contents, quoted across lines or on one line with each newline written as \n.
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=

# Optional: lets workspaces save model provider keys, which it encrypts. `pnpm dev:setup` fills
# in a random one. Never change it once keys are saved: they cannot be opened without it.
# SECRETS_KEY=

# Optional: sends agents' model calls through Cloudflare AI Gateway, for its logs, caching and
# rate limits: https://gateway.ai.cloudflare.com/v1/<account id>/<gateway id>. Without it, calls
# go straight to the providers. The token is only for an authenticated gateway.
# AI_GATEWAY_URL=
# AI_GATEWAY_TOKEN=

# Optional: offers Workers AI models to every workspace, with no key of their own. YOUR Cloudflare
# account pays for the runs, so leave it out unless you mean that. The token is a Cloudflare API
# token with the Workers AI permission; the account id is on the dashboard, or taken from
# AI_GATEWAY_URL above when you leave it out.
# WORKERS_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: pins the app's URL. Leave it out to accept any host, for example from your phone.
# BETTER_AUTH_URL=

# Optional: turns on email (invitations, password reset), such as "Gateweave Agents <agents@example.com>".
# In local dev nothing is sent: each email is printed in the terminal and saved to a file.
# EMAIL_FROM=

# Optional, for sandboxes (the SANDBOX binding; see the README): the ids of the workspaces that
# may use them, separated by commas (every workspace when unset); each workspace's minutes per UTC
# day; the server's US dollars per UTC month; and who hears at 80% and 100% of that budget.
# SANDBOX_WORKSPACES=
# SANDBOX_DAILY_MINUTES=
# SANDBOX_MONTHLY_BUDGET=
# SANDBOX_ALERT_EMAIL=
