// Agents deploys from the repository root, where the "Deploy to Cloudflare" button looks for this
// file; the app itself lives in apps/web, which runs Wrangler and Vite against it.
{
	"$schema": "apps/web/node_modules/wrangler/config-schema.json",
	"name": "gateweave-agents",
	"main": "apps/web/src/server.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Accounts and the list of workspaces. The database is provisioned on first deploy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gateweave-agents",
			"migrations_dir": "apps/web/migrations"
		}
	],
	// Each workspace's registry (projects, repositories, the agents and assets found in them) is
	// one Durable Object, and so is each conversation with an agent. Rate limits on sign-in,
	// password reset and email are counted in one per client address or recipient. The sandbox
	// meter adds up the deployment's sandbox time for a monthly budget (SANDBOX_MONTHLY_BUDGET).
	"durable_objects": {
		"bindings": [
			{ "name": "REGISTRY", "class_name": "RegistryDO" },
			{ "name": "CONVERSATIONS", "class_name": "ConversationAgent" },
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
			{ "name": "SANDBOX_METER", "class_name": "SandboxMeterDO" }
		]
	},
	// RunnerSandbox is each conversation's sandbox. It does nothing unless an environment binds it
	// as SANDBOX with a container, as cloud and staging do: a sandbox needs Docker to deploy and is
	// paid by the account, so self-hosted deploys leave it off until their operator opts in.
	"exports": {
		"RegistryDO": { "type": "durable-object", "storage": "sqlite" },
		"ConversationAgent": { "type": "durable-object", "storage": "sqlite" },
		"RateLimiter": { "type": "durable-object", "storage": "sqlite" },
		"RunnerSandbox": { "type": "durable-object", "storage": "sqlite" },
		"SandboxMeterDO": { "type": "durable-object", "storage": "sqlite" }
	},
	// Email through Cloudflare Email Service. Nothing is sent until EMAIL_FROM names a sender on a
	// domain onboarded to Email Sending; without it, Agents runs with email off.
	"send_email": [{ "name": "EMAIL" }],
	// Optional: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, BETTER_AUTH_URL, EMAIL_FROM, the six
	// GITHUB_APP_* settings of the GitHub App, SECRETS_KEY, AI_GATEWAY_URL with AI_GATEWAY_TOKEN,
	// WORKERS_AI_TOKEN (a secret, never a var here) with CLOUDFLARE_ACCOUNT_ID, and the SANDBOX_*
	// limits (see apps/web/src/server/env.d.ts).
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	// The top level is what self-hosters deploy. Gateweave Cloud deploys the environments below:
	// `cloud` is https://agents.gateweave.com, the same Worker and database the top level names, and
	// `staging` a separate Worker with its own. Bindings are not inherited, so each repeats them.
	"env": {
		"cloud": {
			"name": "gateweave-agents",
			"routes": [{ "pattern": "agents.gateweave.com", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-agents",
					"migrations_dir": "apps/web/migrations"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "REGISTRY", "class_name": "RegistryDO" },
					{ "name": "CONVERSATIONS", "class_name": "ConversationAgent" },
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
					{ "name": "SANDBOX", "class_name": "RunnerSandbox" },
					{ "name": "SANDBOX_METER", "class_name": "SandboxMeterDO" }
				]
			},
			// Cloud's sandboxes are for the workspaces it invites (SANDBOX_WORKSPACES), within these
			// limits. Both secrets are required, so a deploy fails rather than offer sandboxes to every
			// workspace or spend the budget with nobody told.
			"vars": { "SANDBOX_DAILY_MINUTES": "120", "SANDBOX_MONTHLY_BUDGET": "100" },
			"containers": [
				{
					"class_name": "RunnerSandbox",
					"scheduling_policy": "durable_object",
					"images": { "sandbox": { "dockerfile": "./sandbox/Dockerfile" } }
				}
			],
			"send_email": [{ "name": "EMAIL" }],
			"secrets": {
				"required": ["BETTER_AUTH_SECRET", "SANDBOX_WORKSPACES", "SANDBOX_ALERT_EMAIL"]
			}
		},
		"staging": {
			"name": "gateweave-agents-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-agents-staging",
					"migrations_dir": "apps/web/migrations"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "REGISTRY", "class_name": "RegistryDO" },
					{ "name": "CONVERSATIONS", "class_name": "ConversationAgent" },
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
					{ "name": "SANDBOX", "class_name": "RunnerSandbox" },
					{ "name": "SANDBOX_METER", "class_name": "SandboxMeterDO" }
				]
			},
			// Staging's sandboxes are open to every workspace, within these limits. Its operator hears
			// of the budget at SANDBOX_ALERT_EMAIL, a secret.
			"vars": { "SANDBOX_DAILY_MINUTES": "180", "SANDBOX_MONTHLY_BUDGET": "20" },
			// Sandboxes: one container per conversation that uses one, built from sandbox/Dockerfile.
			// Its size is set where it starts, and each workspace has at most three at once
			// (MAX_WORKSPACE_SANDBOXES in packages/model).
			"containers": [
				{
					"class_name": "RunnerSandbox",
					"scheduling_policy": "durable_object",
					"images": { "sandbox": { "dockerfile": "./sandbox/Dockerfile" } }
				}
			],
			"send_email": [{ "name": "EMAIL" }],
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		}
	}
}
