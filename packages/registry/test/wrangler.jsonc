// Worker used only by the test suite to host RegistryDO in isolation.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "agents-registry-test",
	"main": "./worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// A key for the tests' sealed secrets only; it protects nothing. BETTER_AUTH_SECRET is here as
	// every deployment has one: the registry opens what was sealed under the key derived from it
	// before SECRETS_KEY was set. It signs nothing.
	// A Workers AI token and account that exist only here, so the registry sees Workers AI as on.
	"vars": {
		"SECRETS_KEY": "dGVzdC1vbmx5LXNlY3JldHMta2V5LXRlc3Qtb25seS0=",
		"BETTER_AUTH_SECRET": "test-only-auth-secret-that-signs-nothing-0123",
		"WORKERS_AI_TOKEN": "workers-ai-test-token-not-a-real-one",
		"CLOUDFLARE_ACCOUNT_ID": "0123456789abcdef0123456789abcdef",
		"SANDBOX_TURN_COST": "0.01"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "REGISTRY", "class_name": "RegistryDO" },
			// The same registry on a server without a SECRETS_KEY (test/worker.ts).
			{ "name": "REGISTRY_WITHOUT_KEY", "class_name": "RegistryWithoutKey" },
			{ "name": "SANDBOX_METER", "class_name": "SandboxMeterDO" }
		]
	},
	// The deployment's usage events (USAGE); Miniflare keeps none of what is written.
	"analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "agents_registry_test_usage" }],
	"exports": {
		"RegistryDO": { "type": "durable-object", "storage": "sqlite" },
		"RegistryWithoutKey": { "type": "durable-object", "storage": "sqlite" },
		"SandboxMeterDO": { "type": "durable-object", "storage": "sqlite" }
	}
}
