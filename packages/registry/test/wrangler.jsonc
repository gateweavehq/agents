// Worker used only by the test suite to host RegistryDO in isolation.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "agents-registry-test",
	"main": "./worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// A key for the tests' sealed secrets only; it protects nothing.
	// A Workers AI token and account that exist only here, so the registry sees Workers AI as on.
	"vars": {
		"SECRETS_KEY": "dGVzdC1vbmx5LXNlY3JldHMta2V5LXRlc3Qtb25seS0=",
		"WORKERS_AI_TOKEN": "workers-ai-test-token-not-a-real-one",
		"CLOUDFLARE_ACCOUNT_ID": "0123456789abcdef0123456789abcdef"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "REGISTRY", "class_name": "RegistryDO" },
			{ "name": "SANDBOX_METER", "class_name": "SandboxMeterDO" }
		]
	},
	"exports": {
		"RegistryDO": { "type": "durable-object", "storage": "sqlite" },
		"SandboxMeterDO": { "type": "durable-object", "storage": "sqlite" }
	}
}
